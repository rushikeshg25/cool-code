# Set the API key for your chosen provider (Gemini is the default).
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional OpenAI-compatible gateway / CLI proxy key. Name it here, then point
# the trusted global config at it:
#   cool-code config set llm.baseUrl http://localhost:8317/v1
#   cool-code config set llm.apiKeyEnv CLIPROXY_API_KEY
# COOLCODE_API_KEY is deliberately NOT read from .env: it applies with no global
# setting, so a cloned repository could substitute the key requests are billed
# and logged against. Export it in your shell instead.
# CLIPROXY_API_KEY=
